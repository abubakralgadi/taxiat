# ==========================================
# إعدادات Nawa Studio - استديو الواجهات بالذكاء الاصطناعي
# ==========================================

# 1. مفتاح OpenAI API
# احصل على مفتاحك من: https://platform.openai.com/api-keys
OPENAI_API_KEY=ضع_مفتاحك_هنا

# 2. نموذج توليد الصور (الافتراضي: gpt-image-2.5-sunburst لتحرير الواجهات)
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# 3. جودة الصور (low أو medium أو high أو xhigh أو max)
OPENAI_IMAGE_QUALITY=medium

# 4. مقاس الصورة. المقاس الأفقي مناسب للواجهات.
OPENAI_IMAGE_SIZE=1536x1024

# 5. رابط واجهة برمجة التطبيقات (اختياري - في حال استخدام مزود بديل أو بروكسي)
# OPENAI_BASE_URL=https://api.openai.com/v1

# 6. منفذ الخادم
PORT=3000
